package project.canfestival

@BuildArtifactPath(cppflags="-I$(EXTERNAL_BUILD_DIR)/project/canfestival/libcanfestival/install/include")
@BuildDepends(libcanfestival)
@AutoCmd
@Cmd(name = "canfestival_slave",
    help = "Start CANFestival slave node (node-id 0x02, official TestMasterSlave example)")
module canfestival_slave {   
    source "main.c"

	@AddPrefix("^BUILD/extbld/^MOD_PATH/../libcanfestival/install/examples")
	source "Slave.c", "TestSlave.c"

    depends libcanfestival
    depends embox.net.socketcan
}
